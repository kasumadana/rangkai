# Rangkai | Environment variable template
# Commit this example file only. NEVER commit real credentials.
#
# LOCAL SETUP
# 1. Copy SERVER variables into .dev.vars at the project root.
#    Cloudflare Vite plugin / Workers reads .dev.vars locally.
# 2. Copy PUBLIC VITE_ variables into .env.local for frontend use.
# 3. Do NOT put server secrets in a VITE_ variable.
# 4. Do NOT use both .dev.vars and a general .env for Worker secrets.
# 5. Configure production secrets via `pnpm exec wrangler secret put NAME`.
#
# REQUIRED SERVER SECRETS (.dev.vars / Cloudflare Workers secrets)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
BETTER_AUTH_SECRET="REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS"
GEMINI_API_KEY="REPLACE_WITH_YOUR_GEMINI_API_KEY"

# REQUIRED SERVER SETTING (not confidential)
# Set to the actual origin for this environment.
BETTER_AUTH_URL="http://localhost:5173"

# OPTIONAL SERVER SETTINGS
# Match this model to a model available to your Gemini project.
GEMINI_MODEL="gemini-2.5-flash"
APP_ENV="development"
MAX_UPLOAD_BYTES="8388608"
ROAD_STATUS_TTL_MINUTES="30"
AI_REQUEST_TIMEOUT_MS="30000"

# OPTIONAL PUBLIC FRONTEND VARIABLE (.env.local; browser-visible)
# Required only when MapTiler is chosen as the hosted map tile provider.
# Restrict the browser key by allowed HTTP origins in MapTiler.
VITE_MAPTILER_KEY="REPLACE_WITH_YOUR_MAPTILER_PUBLIC_KEY"

# NOT ENVIRONMENT KEYS:
# Cloudflare R2: configure an R2 binding named DOCUMENTS in wrangler.json.
# Example:
# "r2_buckets": [
#   { "binding": "DOCUMENTS", "bucket_name": "rangkai-documents-dev" }
# ]
# There is no R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY for an R2 Worker binding.
#
# Cloudflare deployment: `pnpm exec wrangler login` for manual deployment.
# Optional GitHub Actions deploy: store CLOUDFLARE_API_TOKEN and
# CLOUDFLARE_ACCOUNT_ID in GitHub Actions Secrets, not in this runtime file.
#
# Better Auth optional social login or email delivery providers:
# add provider-specific keys only if those features are implemented.
#
# For production, use production Neon branch, R2 bucket, origin, and secrets.
