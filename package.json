{
	"name": "rangkai",
	"description": "A template for building a React application with Vite, Hono, and Cloudflare Workers",
	"cloudflare": {
		"label": "Vite React Template",
		"products": [
			"Workers"
		],
		"categories": [],
		"preview_icon_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/532a5378-9717-4964-385b-5fafd2160200/public",
		"preview_image_url": "https://imagedelivery.net/wSMYJvS3Xw-n339CbDyDIA/ec7f4be5-d1d6-4e94-0851-126341745400/preview",
		"publish": true
	},
	"dependencies": {
		"@astryxdesign/core": "^0.7.7",
		"@astryxdesign/theme-neutral": "^0.7.7",
		"@astryxdesign/theme-stone": "^0.7.6",
		"@hookform/resolvers": "^7.0.1",
		"@neondatabase/serverless": "^1.2.0",
		"@stylexjs/stylex": "^0.19.1",
		"@tailwindcss/vite": "^4.3.4",
		"@tanstack/react-query": "^5.105.3",
		"better-auth": "^1.7.15",
		"drizzle-orm": "^0.45.4",
		"hono": "4.11.1",
		"lucide-react": "^1.67.0",
		"maplibre-gl": "^6.16.0",
		"react": "19.2.1",
		"react-dom": "19.2.1",
		"react-hook-form": "^7.91.0",
		"react-router": "^8.5.1",
		"tailwindcss": "^4.3.4",
		"zod": "^4.6.7"
	},
	"devDependencies": {
		"@astryxdesign/cli": "^0.7.7",
		"@cloudflare/vite-plugin": "1.52.1",
		"@eslint/js": "9.39.1",
		"@playwright/test": "^1.64.1",
		"@types/node": "24.10.1",
		"@types/react": "19.2.7",
		"@types/react-dom": "19.2.3",
		"@vitejs/plugin-react": "5.1.1",
		"dotenv": "^18.0.9",
		"drizzle-kit": "^0.31.11",
		"eslint": "9.39.2",
		"eslint-plugin-react-hooks": "7.0.1",
		"eslint-plugin-react-refresh": "0.4.24",
		"globals": "16.5.0",
		"tsx": "^4.23.15",
		"typescript": "5.9.3",
		"typescript-eslint": "8.48.0",
		"vite": "^7.0.0",
		"vitest": "^5.1.0",
		"wrangler": "4.156.1"
	},
	"private": true,
	"scripts": {
		"build": "tsc -b && vite build",
		"build:prod": "tsc -b && tsx scripts/build-prod.ts",
		"validate:release": "tsx scripts/release-validator.ts",
		"validate:release:report": "tsx scripts/release-validator.ts --report-only",
		"cf-typegen": "wrangler types",
		"check": "tsc -b && vite build && wrangler deploy --dry-run",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "tsx src/db/migrate.ts",
		"db:seed": "tsx src/db/seed.ts",
		"db:verify": "tsx src/db/verify.ts",
		"deploy": "wrangler deploy",
		"dev": "vite",
		"eval:ai": "tsx scripts/evaluate-ai.ts",
		"lint": "eslint .",
		"preview": "pnpm build && vite preview",
		"smoke": "tsx scripts/smoke.ts",
		"test": "vitest run",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui"
	},
	"type": "module"
}
